{
  "name": "bear-and-burrow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src scripts README.md package.json index.html tsconfig.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check src scripts/generate-art.mjs README.md package.json index.html tsconfig.json vite.config.ts eslint.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/e2e.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
